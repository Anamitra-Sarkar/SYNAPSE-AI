{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build:vercel",
  "outputDirectory": "dist/public",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 60,
      "includeFiles": "api/_morrowApi.mjs"
    },
    "api/trpc/[...procedure].js": {
      "maxDuration": 60,
      "includeFiles": "api/_morrowApi.mjs"
    }
  },
  "routes": [
    { "src": "/api/trpc/(.*)", "dest": "/api/trpc/[...procedure].js" },
    { "src": "/api/(.*)", "dest": "/api/[...path].js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
