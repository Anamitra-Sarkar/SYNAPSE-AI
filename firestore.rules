rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownsProject(projectId) { return signedIn() && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid; }

    match /users/{uid} { allow read, create, update: if signedIn() && request.auth.uid == uid; allow delete: if false; }
    match /projects/{projectId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read, update: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow delete: if false;
      match /{document=**} { allow read, write: if ownsProject(projectId); }
    }
  }
}
